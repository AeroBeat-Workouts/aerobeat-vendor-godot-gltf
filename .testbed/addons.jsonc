{
  "$schema": "https://chickensoft.games/schemas/addons.schema.json",
  "addons": {
    // Install this repo into the hidden workbench the same way a consumer does.
    "aerobeat-vendor-godot-gltf": {
      "url": "..",
      "source": "symlink",
      "subfolder": "/"
    },
    "aerobeat-tool-headless-manager": {
      "url": "../../aerobeat-tool-headless-manager",
      "subfolder": "/",
      "source": "symlink"
    },
    // GUT drives the repo-local test suite inside the hidden testbed/workbench.
    "aerobeat-vendor-godot-unit-test": {
      "url": "../../aerobeat-vendor-godot-unit-test",
      "subfolder": "/",
      "source": "symlink"
    }
  }
}
